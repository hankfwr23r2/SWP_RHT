{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://knowledge-integrate-turner-asbestos.trycloudflare.com/api/v1/:path*"
    },
    {
      "source": "/backoffice/:path*",
      "destination": "/backoffice.html"
    },
    {
      "source": "/backoffice",
      "destination": "/backoffice.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
