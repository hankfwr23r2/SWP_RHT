{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://swp-rht-f9yd.onrender.com/api/v1/:path*"
    },
    {
      "source": "/backoffice/:path*",
      "destination": "/backoffice.html"
    },
    {
      "source": "/backoffice",
      "destination": "/backoffice.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
