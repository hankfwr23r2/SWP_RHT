{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "regex": "^(\\.\\./){2,}", "message": "Không import tương đối quá một cấp. Dùng alias @shared, @customer, @backoffice (AGENTS.md mục 8.3)." }
          ]
        }]
      }
    },
    {
      "files": ["src/apps/customer/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "regex": "^(\\.\\./){2,}", "message": "Không import tương đối quá một cấp. Dùng alias @shared, @customer, @backoffice (AGENTS.md mục 8.3)." },
            { "regex": "(^@backoffice(/|$)|apps/backoffice|(^|/)backoffice/)", "message": "App khách không được dùng code nội bộ (giá vốn, biên lãi). AGENTS.md mục 8.3." }
          ]
        }]
      }
    },
    {
      "files": ["src/apps/backoffice/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "regex": "^(\\.\\./){2,}", "message": "Không import tương đối quá một cấp. Dùng alias @shared, @customer, @backoffice (AGENTS.md mục 8.3)." },
            { "regex": "(^@customer(/|$)|apps/customer)", "message": "App nội bộ không import app khách. Cần dùng chung thì chuyển lên shared (AGENTS.md mục 8.3)." }
          ]
        }]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "regex": "^(\\.\\./){2,}", "message": "Không import tương đối quá một cấp. Dùng alias @shared, @customer, @backoffice (AGENTS.md mục 8.3)." },
            { "regex": "(^@customer(/|$)|^@backoffice(/|$)|apps/|(^|/)backoffice/)", "message": "shared không import apps (AGENTS.md mục 8.3)." }
          ]
        }]
      }
    }
  ]
}
