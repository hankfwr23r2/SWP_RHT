{
  "name": "racehorse-transport",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint && node scripts/check-imports.mjs && node scripts/check-style.mjs",
    "test": "vitest run",
    "build": "npm run lint && tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "api:gen": "openapi-typescript openapi/openapi.json -o src/shared/api/generated/schema.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "axios": "^1.20.0",
    "gsap": "^3.15.0",
    "i18next": "^26.7.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.11",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.4.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.81.0",
    "subset-font": "2.9.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
