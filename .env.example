# Chép file này thành .env (cùng thư mục) rồi điền key; docker compose tự đọc .env.
# .env đã nằm trong .gitignore: không commit key thật, xin key trong nhóm.
# Để trống thì app vẫn chạy, chỉ tính năng tương ứng không dùng được.

# Thanh toán VNPay sandbox (trống: tắt thanh toán VNPay)
VNPAY_HASH_SECRET=

# Lưu ảnh giấy tờ trên Cloudinary (trống: tải ảnh lên báo lỗi)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gửi mã OTP (xác thực email khi đăng ký, quên mật khẩu) qua SMTP (trống: mã OTP in ra log backend)
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_USERNAME là địa chỉ Gmail, MAIL_PASSWORD là App Password 16 ký tự
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
# Hoặc gửi qua API của Brevo (bắt buộc trên Render gói miễn phí vì cổng SMTP bị chặn); có key thì dùng Brevo thay SMTP.
# Địa chỉ gửi là MAIL_USERNAME (hoặc PASSWORD_RESET_FROM) và phải được xác minh trong Brevo > Senders.
BREVO_API_KEY=

# Cloudflare Turnstile public site key; keep the private secret below on the backend only.
VITE_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key (required for unauthenticated form submissions)
TURNSTILE_SECRET_KEY=

# Optional multipart limits (camera API separately validates JPEG <= 5 MB)
APP_UPLOAD_MAX_FILE_SIZE=5MB
APP_UPLOAD_MAX_REQUEST_SIZE=20MB
